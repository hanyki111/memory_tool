digraph ModuleGraph {
    rankdir=LR;
    node [shape=box, style=rounded];

    memory_system [label="memory-system"];
    modules_cli [label="modules / cli"];
    modules_context [label="modules / context"];
    modules_core [label="modules / core"];
    modules_search [label="modules / search"];

    memory_system -> modules_cli;
    memory_system -> modules_context;
    memory_system -> modules_core;
    memory_system -> modules_search;
}