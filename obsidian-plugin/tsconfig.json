{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "CommonJS",
    "target": "ES2021",
    "allowJs": true,
    "strict": true,
    "moduleResolution": "node",
    "importHelpers": true,
    // esbuild does the building; tsc only typechecks. These two let the pure
    // modules use explicit .ts specifiers, which Node's ESM loader requires to
    // run them under `node --test` without a build step.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["DOM", "ES5", "ES6", "ES2021"]
  },
  "include": ["src/**/*"]
}
