<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone in a backup or a device-to-device transfer. The SSH
  key is sealed by a Keystore key that never moves, so a copied key could not
  be opened on the new phone anyway; each phone makes and registers its own.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
