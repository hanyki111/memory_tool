<?xml version="1.0" encoding="utf-8"?>
<!-- The PC's latest entries, then the field of the 4x1 widget at the bottom. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="8dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/recent_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/recent_1_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF62625D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/recent_1_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF1A1A1A"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recent_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/recent_2_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF62625D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/recent_2_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF1A1A1A"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recent_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/recent_3_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:textColor="#FF62625D"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/recent_3_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FF1A1A1A"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:gravity="end"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:textColor="#FF62625D"
        android:textSize="11sp" />
    <!-- A plain View cannot be in a widget; a FrameLayout can. -->
    <FrameLayout
        android:id="@+id/widget_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="6dp"
        android:background="#FFDEDED8" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_field"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_hint"
                android:textColor="#FF62625D"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB3261E"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_voice"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/widget_voice"
            android:padding="12dp"
            android:src="@drawable/ic_mic" />
    </LinearLayout>

</LinearLayout>
