# Memory System - 지식 베이스는 버전 관리 대상 (dogfooding)
# 마크다운 원본(timeline/, modules/, templates/, docs/ ...)은 추적하고,
# 그로부터 다시 만들어지는 인덱스·임베딩·캐시만 제외한다.
# .memory/.index.db
# .memory/.connections.db
# .memory/.embeddings/
# .memory/.cache/
# .memory/.index/
# .memory/cache/
# .memory/.path_check_cache.json
# .memory/.suggestion_cache.json

.memory

